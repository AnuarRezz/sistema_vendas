{
  "rules": {
    "databases": {
      "(default)": {
        "documents": {
          // Permite que qualquer usuário LOGADO leia, crie, edite ou delete produtos
          "products/{productId}": {
            "allow read, write": "if request.auth != null;"
          },
          // Permite que qualquer usuário LOGADO leia, crie, edite ou delete vendas
          "sales/{saleId}": {
            "allow read, write": "if request.auth != null;"
          }
        }
      }
    }
  }
}